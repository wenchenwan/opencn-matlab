# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /home/peter/apps/MATLAB/R2020a
startdir = /home/peter/iai/opencn-soo/agency/usr/matlab/common

# Toolchain information
cc = gcc
cxx = /usr/bin/g++
linker = gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -fwrapv -DNDEBUG -fvisibility=hidden -std=c99 -I "$root" -I "$startdir" -I "$startdir/gen_mex/readgcode" -I "/home/peter/iai/opencn-soo/agency/usr" -I "$startdir/src" -I "/home/peter/iai/opencn-soo/agency/usr/rs274ngc" -I "/home/peter/iai/opencn-soo/agency/usr/common/include" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -D_POSIX_C_SOURCE=199309L -DDEBUG_RS274 -DMEX_READGCODE -DMODEL=ReadGCode_mex -DMW_NEEDS_VERSION_H -fdiagnostics-color=always -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -std=c++11 -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -fwrapv -DNDEBUG -fvisibility=hidden -std=c++11 -I "$root" -I "$startdir" -I "$startdir/gen_mex/readgcode" -I "/home/peter/iai/opencn-soo/agency/usr" -I "$startdir/src" -I "/home/peter/iai/opencn-soo/agency/usr/rs274ngc" -I "/home/peter/iai/opencn-soo/agency/usr/common/include" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -D_POSIX_C_SOURCE=199309L -DDEBUG_RS274 -DMEX_READGCODE -DMODEL=ReadGCode_mex -DMW_NEEDS_VERSION_H -fdiagnostics-color=always -c 

ldflags =  -pthread -Wl,--no-undefined  -shared -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lmat -lm -lstdc++  -o ReadGCode_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwblas -lemlrt -lcovrt -lut -lmwmathutil -ldl

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $ldflags

rule linkxx
    command = $linkerxx $in $ldflags

# Build
build $builddir/cpp_interp.o : cxx $startdir/../common/src/cpp_interp.cpp
build $builddir/interp_arc.o : cxx $startdir/../../rs274ngc/interp_arc.cc
build $builddir/interp_array.o : cxx $startdir/../../rs274ngc/interp_array.cc
build $builddir/interp_base.o : cxx $startdir/../../rs274ngc/interp_base.cc
build $builddir/interp_check.o : cxx $startdir/../../rs274ngc/interp_check.cc
build $builddir/interp_convert.o : cxx $startdir/../../rs274ngc/interp_convert.cc
build $builddir/interp_cycles.o : cxx $startdir/../../rs274ngc/interp_cycles.cc
build $builddir/interp_execute.o : cxx $startdir/../../rs274ngc/interp_execute.cc
build $builddir/interp_find.o : cxx $startdir/../../rs274ngc/interp_find.cc
build $builddir/interp_internal.o : cxx $startdir/../../rs274ngc/interp_internal.cc
build $builddir/interp_inverse.o : cxx $startdir/../../rs274ngc/interp_inverse.cc
build $builddir/interp_namedparams.o : cxx $startdir/../../rs274ngc/interp_namedparams.cc
build $builddir/interp_o_word.o : cxx $startdir/../../rs274ngc/interp_o_word.cc
build $builddir/interp_queue.o : cxx $startdir/../../rs274ngc/interp_queue.cc
build $builddir/interp_read.o : cxx $startdir/../../rs274ngc/interp_read.cc
build $builddir/interp_remap.o : cxx $startdir/../../rs274ngc/interp_remap.cc
build $builddir/interp_setup.o : cxx $startdir/../../rs274ngc/interp_setup.cc
build $builddir/interp_write.o : cxx $startdir/../../rs274ngc/interp_write.cc
build $builddir/ocn.o : cxx $startdir/../../rs274ngc/ocn.cc
build $builddir/rs274ngc_pre.o : cxx $startdir/../../rs274ngc/rs274ngc_pre.cc
build $builddir/inifile.o : cxx $startdir/../../rs274ngc/inifile.cc
build $builddir/rt_nonfinite.o : cxx $root/rt_nonfinite.cpp
build $builddir/ReadGCode_mex.o : cxx $root/ReadGCode_mex.cpp
build $builddir/_coder_ReadGCode_mex_mex.o : cxx $root/interface/_coder_ReadGCode_mex_mex.cpp
build $builddir/_coder_ReadGCode_mex_info.o : cxx $root/interface/_coder_ReadGCode_mex_info.cpp
build $builddir/cpp_mexapi_version.o : cxx $matlabdir/extern/version/cpp_mexapi_version.cpp

# Link
build $root/ReadGCode_mex.mexa64 : linkxx $builddir/cpp_interp.o $builddir/interp_arc.o $builddir/interp_array.o $builddir/interp_base.o $builddir/interp_check.o $builddir/interp_convert.o $builddir/interp_cycles.o $builddir/interp_execute.o $builddir/interp_find.o $builddir/interp_internal.o $builddir/interp_inverse.o $builddir/interp_namedparams.o $builddir/interp_o_word.o $builddir/interp_queue.o $builddir/interp_read.o $builddir/interp_remap.o $builddir/interp_setup.o $builddir/interp_write.o $builddir/ocn.o $builddir/rs274ngc_pre.o $builddir/inifile.o $builddir/rt_nonfinite.o $builddir/ReadGCode_mex.o $builddir/_coder_ReadGCode_mex_mex.o $builddir/_coder_ReadGCode_mex_info.o $builddir/cpp_mexapi_version.o 
